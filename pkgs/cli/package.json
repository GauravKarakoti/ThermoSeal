{
  "name": "cli",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "node --no-warnings --experimental-specifier-resolution=node --import tsx src/server/ingest.ts",
    "deploy:local": "node --no-warnings --experimental-specifier-resolution=node --import tsx scripts/deploy-local.ts",
    "standalone": "docker compose -f standalone.yml pull && node --no-warnings --experimental-specifier-resolution=node --import tsx src/standalone.ts",
    "test-api": "docker compose -f standalone.yml pull && DEBUG='testcontainers' vitest run",
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "node --max-old-space-size=4096 --no-warnings --experimental-specifier-resolution=node --import tsx src/preview.ts",
    "preprod": "node --max-old-space-size=4096 --no-warnings --experimental-specifier-resolution=node --import tsx src/preprod.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "2.5.0",
    "@midnight-ntwrk/compact-runtime": "0.15.0",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.0.4",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-network-id": "4.0.4",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.0.4",
    "@midnight-ntwrk/midnight-js-types": "4.0.4",
    "@midnight-ntwrk/midnight-js-utils": "4.0.4",
    "@midnight-ntwrk/wallet-sdk-address-format": "3.1.0",
    "@midnight-ntwrk/wallet-sdk-dust-wallet": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-facade": "^3.0.0",
    "@midnight-ntwrk/wallet-sdk-hd": "^3.0.2",
    "@midnight-ntwrk/wallet-sdk-shielded": "^2.1.0",
    "@midnight-ntwrk/wallet-sdk-unshielded-wallet": "^2.1.0",
    "contract": "*",
    "express": "^4.19.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rxjs": "^7.8.2",
    "shared": "*",
    "testcontainers": "^11.12.0",
    "tsx": "^4.23.15",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.5"
  }
}